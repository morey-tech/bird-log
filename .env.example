# Copy to .env. Use absolute SSD paths for persistent deployment storage.
RECORDINGS_HOST_DIR=./data/recordings
RECORDER_STATUS_HOST_DIR=./data/status/recorder
AUDIO_DEVICE_MATCH=Yeti
AUDIO_SAMPLE_RATE=48000
# mono captures one channel; left/right/downmix capture stereo and output mono.
AUDIO_CHANNEL_MODE=mono
CHUNK_SECONDS=30
RETENTION_HOURS=24
MIN_FREE_DISK_MB=1024
# MiB; pauses capture at this budget if retention cannot release space.
MAX_RECORDINGS_MB=10000
QUEUE_SECONDS=5
CALLBACK_TIMEOUT_SECONDS=5
RETRY_MAX_SECONDS=60
LOG_LEVEL=INFO

# Analyzer: choose SSD paths, deployment coordinates, and a clip budget.
CLIPS_HOST_DIR=./data/clips
DATABASE_HOST_DIR=./data/db
MODELS_HOST_DIR=./data/models
ANALYZER_STATUS_HOST_DIR=./data/status/analyzer
LATITUDE=45.4215
LONGITUDE=-75.6972
LOCATION_TIMEZONE=America/Toronto
WINDOW_HOP_SECONDS=1.5
MIN_SCORE=0.5
GEO_MIN_SCORE=0.03
ENCOUNTER_GAP_SECONDS=3
MAX_ENCOUNTER_SECONDS=60
CLIP_PADDING_SECONDS=1
CLIP_RETENTION_DAYS=90
MAX_CLIP_STORAGE_MB=10240
ANALYZER_MIN_FREE_DISK_MB=1024
MAX_INPUT_SECONDS=120
MAX_SPECIES_PER_WINDOW=5
SCAN_SECONDS=5
IDLE_FLUSH_SECONDS=90
MAX_ATTEMPTS=3
RETRY_SECONDS=10
STALL_SECONDS=300

# Web dashboard: loopback publishing by default. Add the Pi hostname/IP for LAN access.
WEB_PUBLISH_ADDRESS=127.0.0.1
WEB_PUBLISH_PORT=8080
WEB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WEB_CACHE_HOST_DIR=./data/web-cache
DISPLAY_TIMEZONE=America/Toronto
PAGE_SIZE=50
REFRESH_SECONDS=30
SPECTROGRAM_CACHE_MAX_MB=256
SPECTROGRAM_CACHE_TTL_SECONDS=3600
