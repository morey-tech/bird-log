# Copy to .env. Use absolute SSD paths for persistent deployment storage.
RECORDINGS_HOST_DIR=./data/recordings
RECORDER_STATUS_HOST_DIR=./data/status/recorder
AUDIO_DEVICE_MATCH=Yeti
AUDIO_SAMPLE_RATE=48000
# mono captures one channel; left/right/downmix capture stereo and output mono.
AUDIO_CHANNEL_MODE=mono
CHUNK_SECONDS=30
RETENTION_HOURS=24
MIN_FREE_DISK_MB=1024
# MiB; pauses capture at this budget if retention cannot release space.
MAX_RECORDINGS_MB=10000
QUEUE_SECONDS=5
CALLBACK_TIMEOUT_SECONDS=5
RETRY_MAX_SECONDS=60
LOG_LEVEL=INFO
